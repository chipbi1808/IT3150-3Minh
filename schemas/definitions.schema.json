{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "exam_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "line_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "exam_id",
        "page_id",
        "line_id"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      },
      "required": [
        "code",
        "stage",
        "severity",
        "message",
        "refs"
      ],
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "exam_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_index": {
          "type": "integer",
          "minimum": 1
        },
        "original_image_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "processed_image_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "original_size": {
          "$ref": "#/$defs/size"
        },
        "processed_size": {
          "$ref": "#/$defs/size"
        },
        "original_to_processed": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 3,
          "maxItems": 3
        },
        "preprocessing_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "ok",
            "blank",
            "failed",
            "review_required"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "schema_version",
        "exam_id",
        "page_id",
        "page_index",
        "original_image_path",
        "processed_image_path",
        "original_size",
        "processed_size",
        "original_to_processed",
        "preprocessing_sha256",
        "original_sha256",
        "status",
        "issues"
      ],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "exam_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "line_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "reading_order": {
          "type": "integer",
          "minimum": 1
        },
        "image_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_detection_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "schema_version",
        "exam_id",
        "page_id",
        "line_id",
        "bbox",
        "reading_order",
        "image_path"
      ],
      "additionalProperties": false
    },
    "recognized": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "exam_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "line_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "reading_order": {
          "type": "integer",
          "minimum": 1
        },
        "image_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_detection_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "text": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "empty_prediction",
            "failed"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "required": [
        "schema_version",
        "exam_id",
        "page_id",
        "line_id",
        "bbox",
        "reading_order",
        "image_path",
        "text",
        "status",
        "issues"
      ],
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "exam_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "stage": {
          "enum": [
            "segmentation",
            "ocr"
          ]
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "lines": {
          "type": "array"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "exam_id",
        "run_id",
        "stage",
        "pages",
        "lines",
        "metadata"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "segmentation"
              }
            }
          },
          "then": {
            "properties": {
              "lines": {
                "items": {
                  "$ref": "#/$defs/line"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "ocr"
              }
            }
          },
          "then": {
            "properties": {
              "lines": {
                "items": {
                  "$ref": "#/$defs/recognized"
                }
              }
            }
          }
        }
      ]
    }
  }
}
